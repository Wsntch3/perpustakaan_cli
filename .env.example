# Salin file ini menjadi .env lalu sesuaikan nilainya.
# .env tidak ikut masuk ke git karena berisi password.

# PostgreSQL dari docker-compose (port host 5433)
DATABASE_URL=postgres://library:password@localhost:5433/db_library?sslmode=disable

# Kalau memakai PostgreSQL lokal di port 5432:
# DATABASE_URL=postgres://library:password@localhost:5432/db_library?sslmode=disable
