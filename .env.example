# Salin file ini menjadi .env lalu sesuaikan nilainya.
# .env tidak ikut masuk ke git karena berisi password.

POSTGRES_DB=db_library
POSTGRES_USER=library
POSTGRES_PASSWORD=ganti_dengan_password_kamu
POSTGRES_PORT=5433

DATABASE_URL=postgres://library:ganti_dengan_password_kamu@localhost:5433/db_library?sslmode=disable

# Kalau memakai PostgreSQL lokal di port 5432:
# DATABASE_URL=postgres://library:ganti_dengan_password_kamu@localhost:5432/db_library?sslmode=disable
